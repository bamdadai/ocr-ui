{
    "debug": true,
    "debug_output_path": "debug_results",
    "detection": {
        "device": "cpu",
        "word_detect": {
            "path": "weights/word_detection.pt",
            "conf": 0.2,
            "iou": 0.5,
            "mask_dilation": 0,
            "batch": 8
        },
        "paddle_ocr": {
            "model_name": "PP-OCRv5_server_det",
            "reading_direction": "rtl",
            "pad": 2,
            "sort_reading_order": true,
            "model_kwargs": {}
        },
        "line_detect": {
            "path": "weights/line_detection.pt",
            "conf": 0.2,
            "iou": 0.5,
            "batch": 8
        },
        "parallel_processing": {
            "enabled": true,
            "max_workers": 4,
            "max_batch_size": 8,
            "memory_limit_mb": 8192
        },
        "debug": true,
        "debug_word_path": "debug/word_detections",
        "debug_line_path": "debug/line_detections"
    },
    "recognition": {
        "device": "cpu",
        "batch_size": 64,
        "min_conf": 0.3,
        "debug": true
    },
    "pipeline": {
        "debug": true,
        "enable_recognition": true
    },
    "text_rendering": {
        "same_row_separator": " ",
        "height_tolerance_pixels": 5
    },
    "upload_storage": {
        "chunk_size_bytes": 5242880,
        "ttl_seconds": 7200,
        "policies": [
            {
                "min_size_bytes": 209715200,
                "chunk_size_bytes": 8388608,
                "ttl_seconds": 1800
            },
            {
                "min_size_bytes": 125829120,
                "chunk_size_bytes": 6291456,
                "ttl_seconds": 3600
            }
        ]
    },
    "valid_ocr_formats": [".jpeg", ".jpg", ".png", ".pdf"]
}
