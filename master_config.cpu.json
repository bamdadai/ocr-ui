{
  "debug": true,
  "logging": {
    "level": "INFO",
    "log_requests": true,
    "log_performance": true,
    "log_memory_usage": true,
    "log_model_loading": true
  },
  "detection": {
    "device": "cpu",
    "word_detect": {
      "path": "weights/word_detection.pt",
      "conf": 0.2,
      "iou": 0.3,
      "nms": true,
      "remove_nested": true
    },
    "paddle_ocr": {
      "model_name": "PP-OCRv5_server_det",
      "reading_direction": "rtl",
      "pad": 2,
      "sort_reading_order": true,
      "model_kwargs": {
        "model_dir": "/app/weights/PP-OCRv5_server_det_infer"
      }
    },
    "parallel_processing": {
      "enabled": true,
      "max_workers": 8,
      "max_batch_size": 8,
      "memory_limit_mb": 4096
    },
    "debug": true,
    "debug_word_path": "debug/word_detections",
    "debug_line_path": "debug/line_detections"
  },
  "recognition": {
    "device": "cpu",
    "batch_size": 8,
    "min_conf": 0.7,
    "debug": true,
    "paddle_rec": {
      "model_path": "weights/PP-OCRv5_mobile_rec/best_accuracy",
      "config_path": "weights/PP-OCRv5_mobile_rec/config.yml",
      "use_gpu": false
    },
    "image_preprocessing": {
      "padding": 5,
      "erosion_kernel_size": 0,
      "erosion_iterations": 1,
      "contrast": 1.4,
      "brightness": 0.0,
      "sharpness": 0.0
    },
    "word_boundary_enlargement": {
      "enabled": false,
      "pixels": 2,
      "percentage": null
    },
    "text_postprocessing": {
      "enabled": false,
      "remove_parentheses": true,
      "join_spaced_numbers": true,
      "convert_mixed_digit_sequences": true,
      "fix_dash_positioning": true,
      "fix_period_positioning": true,
      "fix_dash_comma_spacing": true,
      "fix_mixed_text_order": true,
      "apply_custom_replacements": true,
      "normalize_spacing": true,
      "fix_encoding": true,
      "custom_replacements_file": null,
      "custom_replacements_dict": null
    }
  },
  "pipeline": {
    "debug": true,
    "enable_recognition": true
  },
  "text_rendering": {
    "same_row_separator": "\t",
    "height_tolerance_pixels": 5
  },
  "line_splitting": {
    "max_width_height_ratio": 3.0,
    "overlap_threshold": 0.1
  },
  "orientation": {
    "enabled": true,
    "path": "weights/rotation_classifier.pt",
    "device": "cpu",
    "imgsz": 512
  },
  "upload_storage": {
    "chunk_size_bytes": 5242880,
    "ttl_seconds": 7200,
    "policies": [
      {
        "min_size_bytes": 209715200,
        "chunk_size_bytes": 8388608,
        "ttl_seconds": 3600
      },
      {
        "min_size_bytes": 125829120,
        "chunk_size_bytes": 6291456,
        "ttl_seconds": 7200
      }
    ]
  },
  "hybrid_storage": {
    "enabled": true,
    "threshold_mb": 50,
    "small_files_storage": "redis",
    "large_files_storage": "minio",
    "minio": {
      "enabled": true,
      "endpoint": "minio:9000",
      "access_key": "minioadmin",
      "secret_key": "minioadmin2025",
      "bucket_name": "ocr-staging",
      "region": "us-east-1",
      "secure": false
    }
  },
  "valid_ocr_formats": [".jpeg", ".jpg", ".png", ".pdf"]
}
