# ==================================
# Environment Configuration
# ==================================

# Infrastructure Settings
CELERY_BROKER_URL="amqp://user:bambamai2025@rabbitmq:5672//"
CELERY_BACKEND_URL="redis://redis:6379/0"

# Logging Configuration
LOG_FILE_PATH="/app/logs/app.log"
LOG_LEVEL="DEBUG"

# Security Settings
ALLOW_INSECURE_WEBHOOKS=false

# File Paths
SEARCHABLE_PDF_FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

# Optional: Override config file path
# MASTER_CONFIG_PATH="/app/master_config.json"

# Performance Monitoring
ENABLE_PERFORMANCE_LOGGING=true
ENABLE_MEMORY_MONITORING=true

# Debug Settings
ENABLE_DEBUG_LOGGING=true
ENABLE_MODEL_LOADING_LOGS=true
